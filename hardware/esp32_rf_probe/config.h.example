// Copy to config.h and edit. config.h is git-ignored.
//
// WiFi network, password, and backend/security settings are NOT here
// anymore -- they're configured at runtime via the on-device setup portal
// (see wifi_portal.h/.cpp and the README's "Use it" section): first boot
// (or holding the BOOT button at power-on) opens an "RF-Probe-Setup-XXXX"
// access point with a setup page. This file only holds what to sample.
#pragma once

// --- what to sample ---
#define PROBE_CHANNEL      6      // 1..13
#define CHANNEL_WIDTH_MHZ  20     // 20 or 40
#define SAMPLE_WINDOW_MS   3000   // promiscuous capture length
#define BLE_SCAN_SECONDS   3

#define SAMPLE_PERIOD_MS  15000   // delay between samples in loop()
